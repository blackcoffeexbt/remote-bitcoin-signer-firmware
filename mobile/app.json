{
  "expo": {
    "name": "Remote Signer Client",
    "slug": "remote-bitcoin-signer",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pw.sats.remotebitcoinsigner",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to your Electrs server on your local network to sync and broadcast Testnet4 payments."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "pw.sats.remotebitcoinsigner",
      "allowBackup": false,
      "versionCode": 3
    },
    "scheme": "remote-bitcoin-signer",
    "platforms": [
      "android",
      "ios"
    ],
    "plugins": [
      "./plugins/withDeviceScheme",
      "./plugins/withActivityLintWorkaround",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan the pairing QR displayed by your ESP32 signer.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
